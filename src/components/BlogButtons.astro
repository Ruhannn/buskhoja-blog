---
interface Props {
  slug: string
}

const { slug } = Astro.props
---

<div data-slug={slug} id="reactions-section">
  <h3 class="text-lg font-semibold mb-3">React to this post</h3>
  <div class="flex flex-wrap gap-2" id="reactions-container">
    <span class="text-sm text-muted-foreground">Loading reactions...</span>
  </div>
</div>

<div>
  <h3 class="text-xl font-semibold mb-4">Comments</h3>

  <form
    id="comment-form"
    class="mb-6"
  >
    <div class="space-y-4">
      <textarea
        data-slug={slug}
        name="content"
        required
        rows="4"
        class="w-full px-4 py-2 rounded-xl border border-border bg-card text-foreground focus:outline-none focus:ring-2 focus:ring-ring resize-none"
        placeholder="Write your comment..."
      ></textarea>
      <button
        type="submit"
        class="px-6 py-2 rounded-xl bg-secondary text-secondary-foreground transition-colors duration-300 ease-in-out cursor-pointer hover:bg-accent"
      >
        Post Comment
      </button>
    </div>
  </form>

  <div class="comments-container space-y-4">
    <span class="text-sm text-muted-foreground">Loading comments...</span>
  </div>
</div>

<script>
import { api, COMMENTS_URL, REACTION_URL } from '@lib/api'
import { escapeHTML } from 'astro/runtime/server/escape.js'

const STORAGE_KEY = 'user_reactions'

type UserReactions = Record<string, boolean>

function getUserReactions(): UserReactions {
  try {
    const stored = localStorage.getItem(STORAGE_KEY)
    return stored ? JSON.parse(stored) : {}
  }
  catch {
    return {}
  }
}

function saveUserReactions(reactions: UserReactions): void {
  try {
    localStorage.setItem(STORAGE_KEY, JSON.stringify(reactions))
  }
  catch (error) {
    console.error('Failed to save reactions:', error)
  }
}

function hasUserReacted(slug: string, emoji: string): boolean {
  const reactions = getUserReactions()
  return reactions[`${slug}:${emoji}`] === true
}

function markUserReaction(slug: string, emoji: string): void {
  const reactions = getUserReactions()
  reactions[`${slug}:${emoji}`] = true
  saveUserReactions(reactions)
}

async function updateReactionCount(
  recordId: string,
  emoji: string,
  newCount: number,
): Promise<void> {
  await api.patch(REACTION_URL, {
    id: recordId,
    fields: { [emoji]: newCount },
  })
}

async function handleReactionClick(btn: HTMLButtonElement): Promise<void> {
  const { emoji, slug, id } = btn.dataset
  const countEl = btn.querySelector('.reaction-count')

  if (!emoji || !slug || !countEl || !id) {
    console.warn('Missing required data attributes')
    return
  }

  if (hasUserReacted(slug, emoji)) {
    return
  }

  const oldCount = Number.parseInt(countEl.textContent || '0', 10)
  const newCount = oldCount + 1
  countEl.textContent = String(newCount)
  btn.disabled = true

  try {
    await updateReactionCount(id, emoji, newCount)
    markUserReaction(slug, emoji)
  }
  catch (error) {
    console.error('Failed to update reaction:', error)
    countEl.textContent = String(oldCount)
    btn.disabled = false
  }
}

function createCommentElement(comment: string, createdAt: string): HTMLDivElement {
  const div = document.createElement('div')
  div.className = 'comment-item p-4 rounded-xl border border-border bg-card'
  div.innerHTML = `
    <p class="comment-text text-foreground mb-2">${escapeHTML(comment)}</p>
    <p class="comment-time text-sm text-muted-foreground">
      Commented at: <time datetime="${createdAt}">${new Date(createdAt).toLocaleDateString('en-us', {
        month: 'short',
        day: 'numeric',
        year: 'numeric',
      })}</time>
    </p>
  `
  return div
}

async function handleComment(e: Event): Promise<void> {
  e.preventDefault()

  const form = e.currentTarget as HTMLFormElement
  const contentElement = form.elements.namedItem('content') as HTMLTextAreaElement
  const submitBtn = form.querySelector('button[type="submit"]') as HTMLButtonElement
  const textarea = form.querySelector('textarea[data-slug]') as HTMLTextAreaElement

  const slug = textarea?.getAttribute('data-slug')
  const id = textarea?.getAttribute('data-reaction-id')

  if (!contentElement || !slug || !id) {
    console.error('Missing required form data')
    return
  }

  const content = contentElement.value.trim()
  if (!content)
    return

  submitBtn.disabled = true
  const originalBtnText = submitBtn.textContent
  submitBtn.textContent = 'Posting...'

  const container = document.querySelector('.comments-container')
  const noComments = container?.querySelector('.no-comments')

  if (noComments) {
    noComments.remove()
  }

  const tempComment = createCommentElement(content, new Date().toISOString())
  tempComment.style.opacity = '0.6'
  container?.insertBefore(tempComment, container.firstChild)

  try {
    await api.post(COMMENTS_URL, {
      fields: {
        slug,
        content,
        Reactions: { id },
      },
    })

    tempComment.style.opacity = '1'

    form.reset()
    contentElement.value = ''
  }
  catch (error) {
    console.error('Failed to post comment:', error)

    tempComment.remove()

    if (container && container.children.length === 0) {
      container.innerHTML
        = '<p class="no-comments text-muted-foreground">No comments yet. Be the first to comment!</p>'
    }
  }
  finally {
    submitBtn.disabled = false
    submitBtn.textContent = originalBtnText
  }
}

async function getOrCreateRecord(slug: string) {
  const response = await api.get(REACTION_URL, {
    params: {
      where: `(slug,eq,${slug})`,
      pageSize: 1,
      fields: 'content,createdAtArray,slug,👍,🎉,😊,🔥,❤️',
    },
  })

  const records = response.data.records

  if (records.length > 0) {
    return records[0]
  }

  const createResponse = await api.post(REACTION_URL, {
    fields: { slug },
  })

  return createResponse.data
}

async function loadReactionsAndComments(): Promise<void> {
  const section = document.getElementById('reactions-section')
  const slug = section?.getAttribute('data-slug')

  if (!slug) {
    console.error('Missing slug')
    return
  }

  try {
    const data = await getOrCreateRecord(slug)

    const emojiData = Object.entries(data.fields)
      .filter(([key]) => /\p{Emoji}/u.test(key))
      .map(([emoji, count]) => ({ emoji, count }))

    const reactionsContainer = document.getElementById('reactions-container')
    if (reactionsContainer) {
      reactionsContainer.innerHTML = emojiData.map(e => `
        <button
          class="reaction-btn flex items-center gap-2 px-3 py-2 rounded-xl border border-border bg-card hover:bg-accent cursor-pointer hover:scale-105 active:scale-95 transition-all duration-200 disabled:bg-accent disabled:hover:scale-100"
          data-emoji="${e.emoji}"
          data-slug="${slug}"
          data-id="${data.id}"
        >
          <span class="text-xl">${e.emoji}</span>
          <span class="reaction-count text-sm">${e.count ?? 0}</span>
        </button>
      `).join('')

      reactionsContainer.querySelectorAll('.reaction-btn').forEach((element) => {
        const btn = element as HTMLButtonElement
        const { emoji, slug } = btn.dataset

        if (emoji && slug && hasUserReacted(slug, emoji)) {
          btn.disabled = true
        }

        btn.addEventListener('click', () => handleReactionClick(btn))
      })
    }

    const { content, createdAtArray } = data.fields
    const comments: { comment: string, createdAt: Date }[] = content?.map((comment: string, index: number) => ({
      comment,
      createdAt: new Date(createdAtArray[index]),
    })) || []

    const commentsContainer = document.querySelector('.comments-container')
    if (commentsContainer) {
      if (comments.length > 0) {
        commentsContainer.innerHTML = [...comments]
          .sort((a, b) => b.createdAt.getTime() - a.createdAt.getTime())
          .map(item => `
            <div class="comment-item p-4 rounded-xl border border-border bg-card">
              <p class="comment-text text-foreground mb-2">${escapeHTML(item.comment)}</p>
              <p class="comment-time text-sm text-muted-foreground">
                Commented at: <time datetime="${item.createdAt.toISOString()}">${item.createdAt.toLocaleString()}</time>
              </p>
            </div>
          `)
          .join('')
      }
      else {
        commentsContainer.innerHTML = '<p class="no-comments text-muted-foreground">No comments yet. Be the first to comment!</p>'
      }
    }

    const textarea = document.querySelector('textarea[data-slug]')
    if (textarea) {
      textarea.setAttribute('data-reaction-id', data.id)
    }
  }
  catch (error) {
    console.error('Failed to load reactions and comments:', error)

    const reactionsContainer = document.getElementById('reactions-container')
    if (reactionsContainer) {
      reactionsContainer.innerHTML = '<span class="text-sm text-red-500">Failed to load reactions</span>'
    }

    const commentsContainer = document.querySelector('.comments-container')
    if (commentsContainer) {
      commentsContainer.innerHTML = '<span class="text-sm text-red-500">Failed to load comments</span>'
    }
  }
}

const form = document.getElementById('comment-form')
if (form) {
  form.addEventListener('submit', handleComment)
}

loadReactionsAndComments()
</script>
